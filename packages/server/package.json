{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express4": "^1.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "graphql": "^16.12.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@parcel/watcher": "^2.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:codegen\"",
    "dev:server": "nodemon",
    "dev:codegen": "graphql-codegen --config codegen.yml --watch",
    "codegen": "graphql-codegen --config codegen.yml",
    "build": "tsc",
    "start": "node dist/index.js"
  }
}
